NEXT_PUBLIC_APP_URL=https://narakcode.dev

# Set by Vercel on every deployment and read by the footer title block.
# Locally they are unset, so the BUILD field reads "unavailable" — fill them in
# to preview how a deployment renders. VERCEL_ENV: production | preview
VERCEL_ENV=
VERCEL_GIT_COMMIT_SHA=

NEXT_PUBLIC_REGISTRY_NAMESPACE=@nrcode
NEXT_PUBLIC_REGISTRY_NAMESPACE_URL=https://narakcode.dev/r/{name}.json

# Repo star count in the header. No scopes needed.
# https://github.com/settings/tokens
GITHUB_API_TOKEN=

# GitHub contributions graph on the home page and in the component demos.
# https://github.com/grubersjoe/github-contributions-api
NEXT_PUBLIC_GITHUB_CONTRIBUTIONS_API_URL=https://github-contributions-api.jogruber.de/v4

# https://us.posthog.com/project/:id/settings/project
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://p.narakcode.dev

# Discord channel that receives "Was this helpful?" notes from doc pages.
# Channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
# Unset locally: notes are logged to the dev server console instead.
DISCORD_FEEDBACK_WEBHOOK_URL=

# Cloudflare R2 (used by `pnpm capture:sync` to publish screenshots)
# https://dash.cloudflare.com/?to=/:account/r2/api-tokens
# S3 API endpoint, e.g. https://<account>.r2.cloudflarestorage.com
R2_S3_API=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Storefront Backend API (proxied via /api/storefront/* in next.config.ts)
STOREFRONT_API_URL=http://127.0.0.1:8080
